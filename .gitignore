rules.ninja

# Ignore logs and other temporary files
*.log
*.tmp

# Ignore executables and other binary files
*.exe
*.out
*.o
*.obj
*.so
*.dll
*.a
*.lib
*.dylib
*.pdb

# Ignore IDE-specific files
.vscode
.idea
.vscode/
